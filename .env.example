# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=1234567890:REPLACE_ME

# Контроль доступа по Telegram ID (узнать свой ID: команда /id или @userinfobot).
# ADMIN_USER_IDS — администраторы через запятую; могут добавлять пользователей
# командами /adduser <id> и /removeuser <id>. Если пусто — бот открыт для ВСЕХ.
ADMIN_USER_IDS=
# Дополнительный статический белый список через запятую (необязательно)
ALLOWED_USER_IDS=

# --- LLM: любой OpenAI-совместимый API -------------------------------------
# По умолчанию — NVIDIA NIM (build.nvidia.com): бесплатные кредиты по ключу nvapi-…
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-REPLACE_ME
# Цепочка моделей: недоступна первая — бот пробует следующую
# (по LLM_ATTEMPTS_PER_MODEL попыток на каждую)
LLM_MODELS=qwen/qwen3.5-122b-a10b,meta/llama-3.3-70b-instruct,qwen/qwen3-next-80b-a3b-instruct
LLM_ATTEMPTS_PER_MODEL=3

# Запасной провайдер, пробуется когда вся основная цепочка недоступна.
# ВАЖНО: NVIDIA API гео-блокируется в некоторых странах (Беларусь, Россия) —
# в этом случае нужен VPN/прокси на машине бота ЛИБО запасной провайдер,
# например локальная Ollama:
# LLM_FALLBACK_API_BASE=http://localhost:11434/v1
# LLM_FALLBACK_MODELS=qwen3.5:4b
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS=

# Предварительное LLM-разбиение сообщения на дословные блоки (для слабых
# моделей). 0 = LLM решает всё одним вызовом (рекомендуется для больших моделей)
SPLIT_STAGE=0

# --- Распознавание речи ------------------------------------------------------
# Облачное: OpenAI-совместимый /audio/transcriptions. Бесплатный вариант —
# Groq (https://console.groq.com, ключ бесплатно): whisper-large-v3 с русским.
# У NVIDIA NIM хостед-ASR с русским языком сейчас нет.
# Пусто — используется ЛОКАЛЬНЫЙ Whisper (см. WHISPER_MODEL ниже).
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=ru

# Локальный Whisper-фолбэк (tiny/base/small/medium/large), нужен ffmpeg
WHISPER_MODEL=medium

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TZ=Europe/Minsk

# Путь к базе данных SQLite
DB_PATH=data/bot.db

# Файл логов (ротация: 5 МБ × 3 файла). Пустое значение — только stdout.
LOG_FILE=data/bot.log

# Интервал опроса планировщика, сек
POLL_INTERVAL=15

# Таймаут запроса к LLM, сек (время НА ОТВЕТ модели, не на соединение).
# Локальная Ollama на CPU может грузить модель в память минутами — не занижайте
LLM_TIMEOUT=180

# Таймаут ТОЛЬКО на установку соединения, сек. Отдельно от LLM_TIMEOUT:
# заблокированный/недоступный хост (например, гео-блок) отваливается за
# эти секунды, а не ждёт полный LLM_TIMEOUT, как медленно отвечающая модель.
# Тот же таймаут используется для облачного ASR (ASR_API_BASE)
LLM_CONNECT_TIMEOUT=10

# На сколько секунд провайдер/модель помечается недоступным после
# исчерпания попыток — следующие сообщения пропускают его без повторных
# попыток, пока кулдаун не истечёт (и сразу пробуют следующего в цепочке)
LLM_COOLDOWN=120
